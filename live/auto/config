#!/bin/sh
# live-build configuration for catos. `lb config` calls this automatically.
# ARCH is amd64 (the real box) or arm64 (fast VMs on Apple Silicon).
set -e

arch="${ARCH:-amd64}"
case "$arch" in
    amd64) bootloaders="grub-efi,syslinux" ;;
    arm64) bootloaders="grub-efi" ;;
esac

lb config noauto \
  --mode debian \
  --distribution trixie \
  --architecture "$arch" \
  --archive-areas "main contrib non-free non-free-firmware" \
  --apt-recommends false \
  --binary-images iso-hybrid \
  --bootloaders "$bootloaders" \
  --debian-installer none \
  --firmware-binary false \
  --firmware-chroot false \
  --memtest none \
  --security true \
  --updates true \
  --iso-application "catos" \
  --iso-volume "CATOS" \
  --bootappend-live "boot=live components persistence quiet loglevel=3 vt.global_cursor_default=0 hostname=catos username=tv live-config.noautologin timezone=Europe/London locales=en_GB.UTF-8" \
  "${@}"

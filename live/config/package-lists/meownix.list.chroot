# Everything that goes into the image. Recommends are off, so list what we need.

# Base system
systemd-sysv
systemd-timesyncd
dbus-user-session
polkitd
ca-certificates
locales
tzdata
sudo
less
nano

# Graphics and video decode
libgl1-mesa-dri
mesa-va-drivers

# The real box (Intel): microcode, GPU/video decode, Wi-Fi, sound firmware.
# The arm64 build is only for VMs, so it skips these.
#if ARCHITECTURES amd64
intel-microcode
intel-media-va-driver-non-free
firmware-intel-graphics
firmware-iwlwifi
firmware-realtek
firmware-sof-signed
#endif

# NVIDIA's own driver, for PCs with NVIDIA cards (550 still supports Pascal
# cards like the GTX 10 series). The kernel module is built for the image's
# kernel at build time (DKMS). It only loads on NVIDIA hardware: Intel boxes like
# the NGC-1 carry on with Mesa. No Xorg driver: cage only needs EGL and GBM.
# The libraries below are only "recommended" by nvidia-driver-libs, and the
# image skips recommends, but cage needs them: without NVIDIA's GBM backend
# (libnvidia-allocator1) buffers come from Mesa's software renderer and
# nothing can draw into them.
#if ARCHITECTURES amd64
linux-headers-amd64
nvidia-kernel-dkms
nvidia-driver-libs
libegl-nvidia0
libnvidia-egl-gbm1
libnvidia-allocator1
libgles-nvidia2
libglx-nvidia0
#endif

# Networking
network-manager

# Audio
pipewire
pipewire-pulse
pipewire-alsa
wireplumber

# Display: cage is a kiosk Wayland compositor that shows one app fullscreen
cage
xwayland
fonts-inter
fonts-dejavu-core
fonts-noto-color-emoji

# Libraries the crossbar menu (meownix-menu, Rust/egui) loads at runtime
libegl1
# OpenGL without GLX, for the Live2D avatar
libopengl0
libegl-mesa0
libwayland-client0
libwayland-egl1
libwayland-cursor0
libxkbcommon0

# Apps. FreeTube is not in Debian: build.sh drops its .deb into config/packages.chroot
firefox-esr
freetube
webext-ublock-origin-firefox

# Debugging the remote's key codes
evtest
